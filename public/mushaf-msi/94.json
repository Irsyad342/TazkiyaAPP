{"surah":{"number":94,"arabic":"الشّرح","latin":"Asy-Syarḥ","transliteration":"Asy-Syarh","translation":"Pelapangan","verses":8,"page":596},"bismillah":null,"ayahs":[{"n":1,"t":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","p":596,"j":30,"tr":"Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),"},{"n":2,"t":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","p":596,"j":30,"tr":"meringankan beban (tugas-tugas kenabian) darimu"},{"n":3,"t":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ","p":596,"j":30,"tr":"yang memberatkan punggungmu,"},{"n":4,"t":"وَرَفَعْنَا لَكَ ذِكْرَكَۗ","p":596,"j":30,"tr":"dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?"},{"n":5,"t":"فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ","p":596,"j":30,"tr":"Maka, sesungguhnya beserta kesulitan ada kemudahan."},{"n":6,"t":"اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ","p":596,"j":30,"tr":"Sesungguhnya beserta kesulitan ada kemudahan."},{"n":7,"t":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","p":596,"j":30,"tr":"Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)"},{"n":8,"t":"وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ","p":596,"j":30,"tr":"dan hanya kepada Tuhanmu berharaplah!"}]}