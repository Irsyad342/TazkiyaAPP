{"surah":{"number":107,"arabic":"الماعون","latin":"Al-Mā‘ūn","transliteration":"Al-Ma‘un","translation":"Bantuan","verses":7,"page":602},"bismillah":null,"ayahs":[{"n":1,"t":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ","p":602,"j":30,"tr":"Tahukah kamu (orang) yang mendustakan agama?"},{"n":2,"t":"فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ","p":602,"j":30,"tr":"Itulah orang yang menghardik anak yatim"},{"n":3,"t":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ","p":602,"j":30,"tr":"dan tidak menganjurkan untuk memberi makan orang miskin."},{"n":4,"t":"فَوَيْلٌ لِّلْمُصَلِّيْنَۙ","p":602,"j":30,"tr":"Celakalah orang-orang yang melaksanakan salat,"},{"n":5,"t":"الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ","p":602,"j":30,"tr":"(yaitu) yang lalai terhadap salatnya,761)"},{"n":6,"t":"الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ","p":602,"j":30,"tr":"yang berbuat riya,762)"},{"n":7,"t":"وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ","p":602,"j":30,"tr":"dan enggan (memberi) bantuan."}]}