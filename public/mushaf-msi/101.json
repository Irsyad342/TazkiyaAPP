{"surah":{"number":101,"arabic":"القارعة","latin":"Al-Qāri‘ah","transliteration":"Al-Qari‘ah","translation":"Al-Qāri‘ah","verses":11,"page":600},"bismillah":null,"ayahs":[{"n":1,"t":"اَلْقَارِعَةُۙ","p":600,"j":30,"tr":"Al-Qāri‘ah (hari Kiamat yang menggetarkan)."},{"n":2,"t":"مَا الْقَارِعَةُ ۚ","p":600,"j":30,"tr":"Apakah al-Qāri‘ah itu?"},{"n":3,"t":"وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ","p":600,"j":30,"tr":"Tahukah kamu apakah al-Qāri‘ah itu?"},{"n":4,"t":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ","p":600,"j":30,"tr":"Pada hari itu manusia seperti laron yang beterbangan"},{"n":5,"t":"وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ","p":600,"j":30,"tr":"dan gunung-gunung seperti bulu yang berhamburan."},{"n":6,"t":"فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗۙ","p":600,"j":30,"tr":"Siapa yang berat timbangan (kebaikan)-nya,"},{"n":7,"t":"فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ","p":600,"j":30,"tr":"dia berada dalam kehidupan yang menyenangkan."},{"n":8,"t":"وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ","p":600,"j":30,"tr":"Adapun orang yang ringan timbangan (kebaikan)-nya,"},{"n":9,"t":"فَاُمُّهٗ هَاوِيَةٌ  ۗ","p":600,"j":30,"tr":"tempat kembalinya adalah (neraka) Hawiyah."},{"n":10,"t":"وَمَآ اَدْرٰىكَ مَا هِيَهْۗ","p":600,"j":30,"tr":"Tahukah kamu apakah (neraka Hawiyah) itu?"},{"n":11,"t":"نَارٌ حَامِيَةٌ ࣖ","p":600,"j":30,"tr":"(Ia adalah) api yang sangat panas."}]}