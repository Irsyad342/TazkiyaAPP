{"surah":{"number":112,"arabic":"الاخلاص","latin":"Al-Ikhlāṣ","transliteration":"Al-Ikhlas","translation":"Ikhlas","verses":4,"page":604},"bismillah":null,"ayahs":[{"n":1,"t":"قُلْ هُوَ اللّٰهُ اَحَدٌۚ","p":604,"j":30,"tr":"Katakanlah (Nabi Muhammad), “Dialah Allah Yang Maha Esa."},{"n":2,"t":"اَللّٰهُ الصَّمَدُۚ","p":604,"j":30,"tr":"Allah tempat meminta segala sesuatu."},{"n":3,"t":"لَمْ يَلِدْ وَلَمْ يُوْلَدْۙ","p":604,"j":30,"tr":"Dia tidak beranak dan tidak pula diperanakkan"},{"n":4,"t":"وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ࣖ","p":604,"j":30,"tr":"serta tidak ada sesuatu pun yang setara dengan-Nya.”"}]}