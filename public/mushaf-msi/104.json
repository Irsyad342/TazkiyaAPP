{"surah":{"number":104,"arabic":"الهمزة","latin":"Al-Humazah","transliteration":"Al-Humazah","translation":"Pengumpat","verses":9,"page":601},"bismillah":null,"ayahs":[{"n":1,"t":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ","p":601,"j":30,"tr":"Celakalah setiap pengumpat lagi pencela"},{"n":2,"t":"ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ","p":601,"j":30,"tr":"yang mengumpulkan harta dan menghitung-hitungnya."},{"n":3,"t":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ","p":601,"j":30,"tr":"Dia (manusia) mengira bahwa hartanya dapat mengekalkannya."},{"n":4,"t":"كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ","p":601,"j":30,"tr":"Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah."},{"n":5,"t":"وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ","p":601,"j":30,"tr":"Tahukah kamu apakah (neraka) Hutamah?"},{"n":6,"t":"نَارُ اللّٰهِ الْمُوْقَدَةُۙ","p":601,"j":30,"tr":"(Ia adalah) api (azab) Allah yang dinyalakan"},{"n":7,"t":"الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ","p":601,"j":30,"tr":"yang (membakar) naik sampai ke hati."},{"n":8,"t":"اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ","p":601,"j":30,"tr":"Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,"},{"n":9,"t":"فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ","p":601,"j":30,"tr":"(sedangkan mereka) diikat pada tiang-tiang yang panjang."}]}