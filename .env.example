# Salin file ini menjadi .env (jangan pernah di-commit) lalu isi nilai aslinya
# dari dashboard Supabase (Project Settings → API).

# ---------- Autentikasi & sinkronisasi akun (WAJIB untuk fitur login) ----------
# Project URL — dashboard Supabase → Project Settings → API → Project URL
# Contoh bentuk: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key (BUKAN service_role!) — dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Catatan: kedua variabel bersifat publik (dibaca browser) — keamanan data
# dijaga Row Level Security (lihat supabase/schema.sql), bukan kerahasiaan key.
# Tanpa kedua variabel ini, aplikasi tetap berjalan penuh secara lokal
# dan UI akun menampilkan kondisi "belum dikonfigurasi" secara jujur.
